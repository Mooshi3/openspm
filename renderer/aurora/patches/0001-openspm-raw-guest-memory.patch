 #include "../gfx/depth_peek.hpp"
@@
     case CP_CMD_CALL_DL: {
-      // Call display list: 8 bytes (address + size)
-      Log.warn("Ignoring nested GX_CMD_CALL_DL");
-      reader.skip(8);
+      const u32 guestAddress = reader.read<u32>();
+      const u32 displayListSize = reader.read<u32>();
+      if (!guest_memory::has_mapper()) {
+        Log.warn("Ignoring nested GX_CMD_CALL_DL");
+        break;
+      }
+
+      guest_memory::Span span;
+      if (!guest_memory::map(guestAddress, displayListSize, &span)) {
+        FATAL("GX_CMD_CALL_DL references unmapped guest memory: address=0x{:08X}, size={}",
+              guestAddress, displayListSize);
+      }
+
+      const ProcessResult nested = process(span.data, displayListSize);
+      if (nested.drawDone) {
+        return {static_cast<u32>(reader.offset()), true};
+      }
       break;
     }
