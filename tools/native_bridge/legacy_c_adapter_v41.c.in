            (unsigned long long)g_m14_dev58_v19_pre_end,
            (unsigned long long)g_m14_dev58_v19_post_end,
            (unsigned)g_m14_dev58_v19_permit_armed,
            (unsigned)g_m14_dev58_v19_permit_pc);
        bridge_v44_log(instance, message);
        bridge_dev58_log_hh(instance);
        if (instance->cpu.host_call == bridge_host_call_dev58)
            instance->cpu.host_call = g_m14_dev58_underlying_host_call;
    }

    g_m14_dev58_instance = NULL;
    g_m14_dev58_underlying_host_call = NULL;
    bridge_dev58_clear_v19();
    if (g_m14_dev58_underlying_destroy != NULL)
        g_m14_dev58_underlying_destroy(opaque);
}
