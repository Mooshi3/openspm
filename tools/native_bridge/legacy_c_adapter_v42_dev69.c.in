/* dev96: Seeky's EU0 data map translated by the independently proven
 * seqWork delta lands exactly on the US2 globals beside seq_mapchange_wp:
 *   EU0 seqWork 0x80512360 -> US2 0x804D0D60 (-0x41600)
 *   EU0 now/next/prev 0x805AE0B8/C/0 -> US2 0x8056CAB8/C/C0.
 * Observing next_seq at the exact native spmarioMain entry catches direct
 * native-to-native seqSetSeq calls that never cross CPUState::host_call. */
#define OPENSPM_M14_DEV96_NOW_SEQ     UINT32_C(0x8056CAB8)
