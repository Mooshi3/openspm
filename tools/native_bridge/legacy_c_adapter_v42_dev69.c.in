/* dev95: observation-only US2 sequence transition trace.
 *
 * Seeky's US2 symbol map matches this exact player build (spmarioMain
 * 0x801A7AAC). Keep seqSetSeq host-visible through dev87 and record only rare
 * sequence requests/transitions. Guest state is never modified.
 */
#define OPENSPM_M14_DEV95_SEQ_SET_SEQ UINT32_C(0x8017B834)
#define OPENSPM_M14_DEV95_SEQ_WORK    UINT32_C(0x804D0D60)
