/*
 * M14 dev68 LLVM runnable-idle repair over dev67/dev63/dev58.
 *
 * dev67's Windows log exposed the PC-only idle gate: GX finish wakes a thread
 * (RunQueueBits=0x8000), but v7 sleeps until VI because PC still equals the idle
 * continuation. v7 now reads the live run queue before sleeping, allowing the
 * existing native scheduler to run. No guest context/queue or VI deadline is
 * fabricated. The generated-C baseline keeps its historical path.
 *
 * The slice profiler now uses host monotonic time, explicitly reports time in
 * idle Sleep, and gives Space-Saving estimates their error bounds. MSVC clock()
 * measures wall time, not CPU time; its 1 ms granularity also hid short slices.
 *
 * dev66 proved that OpenSPM's ordinary semantic router was spectacularly
 * wasteful but was not the missing 2x: a clean long run produced ~529 million
 * public host callbacks, ~526 million exact-PC bypass hits, and only ~2.84
 * million calls into the underlying production router, yet spmarioMain still
 * remained about 30-31 Hz against 60-62 VI retraces.  Therefore do not spend
 * another iteration optimizing router comparisons.
 *
 * The same run class also exposed a correctness risk in dev66's learning rule.
 * One wedding-cutscene AFK run stopped making guest progress at 0x80065128 for
 * minutes while VI remained healthy.  A false/no-immediate-state-change callback
 * is not proof that an address is permanently non-semantic: a state-dependent
 * callback can be dormant on its first visit and become necessary later.
 * Because dev66 did not produce a cadence win, that speculative ordinary-PC
 * cache is retired completely rather than patched with more exclusions.
 *
 * dev67 keeps the proven dev63 positive native-region admission cache, exact
 * dev58/v19 semantics, and the existing chunk-128 LLVM objects.  It adds only
 * low-frequency observation around the native run() boundary:
 *
 *   - elapsed run-slice histogram + weighted heavy pairs of start/end guest PCs;
 *   - a bounded local instruction/register dump if 0x80065128 remains the exact
 *     returned PC for 64 and 1024 consecutive slices.
 *
 * No host_call callback is wrapped or classified here, so ordinary dispatch
 * semantics are exactly the v41/dev58 production path again.  The profiler runs
 * once per native slice (hundreds per second), not once per guest/public
 * dispatch (hundreds of millions per session), keeping measurement overhead
 * negligible relative to the pathology being investigated.
 *
 * Source-contract anchors inherited through the included bridge chain:
 * m14-dev49-llvm-pc-display-list-return
 * m14-dev51-llvm-test-ready-gx-input
 * m14-dev52-llvm-frame-phase-continuation
 * m14-dev63-llvm-inline-admission-cache
 * M14 native retrace phase-lock active: fixed 60 Hz deadline grid; elapsed deadlines are skipped, never burst-delivered.
 *
 * Previous marker: m14-dev67-llvm-safe-slice-profiler
 * Active marker: m14-dev68-llvm-runnable-idle-wake
 */

#pragma push_macro("openspm_native_module_query")
#undef openspm_native_module_query
#define openspm_native_module_query openspm_native_module_query_dev67_base
#include "legacy_c_adapter_v41.c.in"
#undef openspm_native_module_query
#pragma pop_macro("openspm_native_module_query")

#ifdef DOLRECOMP_BACKEND_LLVM

#ifndef OPENSPM_M14_LLVM_CHUNK_INSTRUCTIONS
#error "LLVM bridge requires OPENSPM_M14_LLVM_CHUNK_INSTRUCTIONS"
#endif
#if OPENSPM_M14_LLVM_CHUNK_INSTRUCTIONS != 128 && \
    OPENSPM_M14_LLVM_CHUNK_INSTRUCTIONS != 256 && \
    OPENSPM_M14_LLVM_CHUNK_INSTRUCTIONS != 512
#error "Unsupported OpenSPM LLVM chunk A/B geometry"
#endif
#define OPENSPM_M14_STRINGIFY_INNER(value) #value
#define OPENSPM_M14_STRINGIFY(value) OPENSPM_M14_STRINGIFY_INNER(value)
#ifndef OPENSPM_M14_LLVM_STATE_IN_MEMORY
#error "LLVM bridge requires OPENSPM_M14_LLVM_STATE_IN_MEMORY"
#endif
#if OPENSPM_M14_LLVM_STATE_IN_MEMORY != 0 && \
    OPENSPM_M14_LLVM_STATE_IN_MEMORY != 1
#error "Unsupported OpenSPM LLVM state-memory A/B mode"
#endif
#ifndef OPENSPM_M14_HEAVY_DIAGNOSTICS
#error "LLVM bridge requires OPENSPM_M14_HEAVY_DIAGNOSTICS"
#endif
#if OPENSPM_M14_HEAVY_DIAGNOSTICS != 0 && \
    OPENSPM_M14_HEAVY_DIAGNOSTICS != 1
#error "Unsupported OpenSPM LLVM heavy-diagnostics mode"
#endif
#if OPENSPM_M14_HEAVY_DIAGNOSTICS
#define OPENSPM_M14_DIAGNOSTIC_SUFFIX "-profile"
#else
#define OPENSPM_M14_DIAGNOSTIC_SUFFIX "-normal"
#endif
#if OPENSPM_M14_LLVM_STATE_IN_MEMORY
#define OPENSPM_M14_EXPERIMENT_VERSION \
    "m14-dev122-chunk" OPENSPM_M14_STRINGIFY(OPENSPM_M14_LLVM_CHUNK_INSTRUCTIONS) "-sim1-yold" OPENSPM_M14_DIAGNOSTIC_SUFFIX
#else
#define OPENSPM_M14_EXPERIMENT_VERSION \
    "m14-dev122-chunk" OPENSPM_M14_STRINGIFY(OPENSPM_M14_LLVM_CHUNK_INSTRUCTIONS) "-sim0-yold" OPENSPM_M14_DIAGNOSTIC_SUFFIX
#endif

