/* dev111: NPC-active-cost + Mario-motion probe.
 *
 * dev110's live A/B proved that clearing NPCEntry::active makes the heavy room
 * immediately smooth, while global logic freeze only partially helps and the
 * documented hidden+frozen flag does not. Count exact dispDraw callback targets
 * at the already-existing dev105 nested-call boundary without adding clocks or
 * CFG edges to generated guest code.
 *
 * At phase 3 (after spmarioMain), sample Mario X/Z once per produced frame.
 * This separates guest-position backsteps from uneven frame delivery. */
#define OPENSPM_M14_DEV111_DISP_SLOTS 256u
#define OPENSPM_M14_DEV111_REPORT_FRAMES 16u
typedef struct openspm_m14_dev111_disp_slot {
    uint32_t target;
    uint64_t count;
} openspm_m14_dev111_disp_slot;

static openspm_m14_dev111_disp_slot
    g_m14_dev111_disp_slots[OPENSPM_M14_DEV111_DISP_SLOTS];
