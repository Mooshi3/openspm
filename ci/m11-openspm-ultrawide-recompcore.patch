+// OpenSPM native frontend settings.
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Core/Config/OpenSPMSettings.h"
+
+#include "Common/Config/Config.h"
+#include "Core/Config/GraphicsSettings.h"
+#include "Core/Core.h"
+#include "Core/PowerPC/StaticRecomp/StaticRecompCore.h"
+#include "Core/System.h"
+#include "VideoCommon/VideoConfig.h"
+
+namespace Config
+{
+const Info<u32> MAIN_OPENSPM_ASPECT_RATIO{{System::Main, "OpenSPM", "AspectRatio"}, 0u};
+}  // namespace Config
+
+namespace OpenSPM
+{
+namespace
+{
+AspectRatio NormalizeAspectRatio(u32 raw)
+{
+  if (raw > static_cast<u32>(AspectRatio::Ultra32_9))
+    return AspectRatio::Auto;
+  return static_cast<AspectRatio>(raw);
+}
+}  // namespace
+
+AspectRatio GetAspectRatio()
+{
+  return NormalizeAspectRatio(Config::Get(Config::MAIN_OPENSPM_ASPECT_RATIO));
+}
+
+void SetAspectRatio(AspectRatio requested_mode)
+{
+  const AspectRatio mode = NormalizeAspectRatio(static_cast<u32>(requested_mode));
+  Config::SetBaseOrCurrent(Config::MAIN_OPENSPM_ASPECT_RATIO, static_cast<u32>(mode));
+
+  switch (mode)
+  {
+  case AspectRatio::Auto:
+    Config::SetBaseOrCurrent(Config::GFX_ASPECT_RATIO, AspectMode::Auto);
+    break;
+  case AspectRatio::Standard4_3:
+    Config::SetBaseOrCurrent(Config::GFX_ASPECT_RATIO, AspectMode::ForceStandard);
+    break;
+  case AspectRatio::Wide16_9:
+    Config::SetBaseOrCurrent(Config::GFX_ASPECT_RATIO, AspectMode::ForceWide);
+    break;
+  case AspectRatio::Ultra21_9:
+    Config::SetBaseOrCurrent(Config::GFX_CUSTOM_ASPECT_RATIO_WIDTH, 21);
+    Config::SetBaseOrCurrent(Config::GFX_CUSTOM_ASPECT_RATIO_HEIGHT, 9);
+    Config::SetBaseOrCurrent(Config::GFX_ASPECT_RATIO, AspectMode::CustomStretch);
+    break;
+  case AspectRatio::Ultra32_9:
+    Config::SetBaseOrCurrent(Config::GFX_CUSTOM_ASPECT_RATIO_WIDTH, 32);
+    Config::SetBaseOrCurrent(Config::GFX_CUSTOM_ASPECT_RATIO_HEIGHT, 9);
+    Config::SetBaseOrCurrent(Config::GFX_ASPECT_RATIO, AspectMode::CustomStretch);
+    break;
+  }
+
+  auto& system = Core::System::GetInstance();
+  if (!Core::IsUninitialized(system))
+  {
+    Core::RunOnCPUThread(system, [mode] {
+      if (g_static_recomp_core)
+        g_static_recomp_core->SetOpenSPMAspectRatio(static_cast<u32>(mode));
+    });
+  }
+}
+}  // namespace OpenSPM
