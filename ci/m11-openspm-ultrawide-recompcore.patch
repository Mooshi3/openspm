+void MenuBar::AddOpenSPMMenu()
+{
+  auto* const openspm_menu = addMenu(tr("OpenSPM"));
+  auto* const aspect_menu = openspm_menu->addMenu(tr("Aspect Ratio"));
+  auto* const group = new QActionGroup(aspect_menu);
+  group->setExclusive(true);
+
+  // Re-apply the persisted OpenSPM choice so the host presenter and game module share one backend.
+  const OpenSPM::AspectRatio current = OpenSPM::GetAspectRatio();
+  OpenSPM::SetAspectRatio(current);
+
+  const auto add_aspect = [this, aspect_menu, group, current](const QString& label,
+                                                              OpenSPM::AspectRatio mode) {
+    QAction* const action = aspect_menu->addAction(label);
+    action->setCheckable(true);
+    action->setChecked(current == mode);
+    group->addAction(action);
+    connect(action, &QAction::triggered, this, [mode](bool checked) {
+      if (checked)
+        OpenSPM::SetAspectRatio(mode);
+    });
+  };
+
+  add_aspect(tr("Auto"), OpenSPM::AspectRatio::Auto);
+  add_aspect(tr("4:3"), OpenSPM::AspectRatio::Standard4_3);
+  add_aspect(tr("16:9"), OpenSPM::AspectRatio::Wide16_9);
+  add_aspect(tr("21:9"), OpenSPM::AspectRatio::Ultra21_9);
+  add_aspect(tr("32:9"), OpenSPM::AspectRatio::Ultra32_9);
+}
